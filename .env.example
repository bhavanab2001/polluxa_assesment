# ============================================================
# Polluxa Analytics Platform — Environment Configuration Template
# ============================================================

# ── Database ─────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=polluxa_analytics
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# Fully composed DATABASE_URL
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/polluxa_analytics

# ── Polluxa API ──────────────────────────────────────────────
POLLUXA_API_BASE_URL=https://sales.polluxa.com/api
POLLUXA_API_TOKEN=your_polluxa_api_token_here

# ── Pipeline Settings ────────────────────────────────────────
DATA_SOURCE_MODE=csv
CSV_IMPORT_DIR=./data/imports
LOADER_BATCH_SIZE=500

# ── Rate Limiting ────────────────────────────────────────────
API_REQUEST_DELAY=1.0
API_MAX_RETRIES=3
API_RETRY_BASE_DELAY=2.0

# ── Data Quality ─────────────────────────────────────────────
DQ_PASS_THRESHOLD=85.0

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=console
